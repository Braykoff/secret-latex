#!/bin/sh
# TeXShop engine script: acts as a drop-in lualatex replacement.
# TeXShop runs this with the document's directory as the working directory and
# the document's full path as $1 (it may pass extra arguments after that; like
# TeXShop's own engines, we ignore them).
#
# TeXShop is a GUI app, so it doesn't inherit your shell's PATH. Add the places
# secret-latex (pipx / pip --user) and TeX Live/MacTeX normally live.
for d in "$HOME"/Library/Python/*/bin; do
    [ -d "$d" ] && PATH="$d:$PATH"
done
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/Library/TeX/texbin:/usr/texbin:$PATH"
export PATH

if ! command -v secret-latex >/dev/null 2>&1; then
    echo "secret-latex: command not found. Install it with 'pipx install secret-latex'."
    echo "Searched PATH: $PATH"
    exit 127
fi

exec secret-latex engine lualatex -file-line-error -synctex=1 "$1"
